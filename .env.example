# Configure three distinct demo accounts. Do not commit your real .env file.
HF_ADMIN_USERNAME=admin
HF_ADMIN_PASSWORD=replace_with_a_strong_admin_password

HF_MANAGER_USERNAME=operations
HF_MANAGER_PASSWORD=replace_with_a_strong_operations_password

HF_CLINICAL_USERNAME=clinical
HF_CLINICAL_PASSWORD=replace_with_a_strong_clinical_password

# Keep your existing Gemini configuration in your local .env as well.
GOOGLE_API_KEY=your_google_api_key
GOOGLE_MODEL=gemini-3.8-flash
